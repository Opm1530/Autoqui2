rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myCompany() {
      return hasUserDoc()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
        : '__none__';
    }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'ginannymoreira@gmail.com' ||
        (hasUserDoc() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    // Escrita permitida: admin, ou o campo de empresa do doc == empresa do usuário.
    // create usa request.resource.data (doc novo); update/delete usa resource.data (doc atual).
    function ownsCreate(field) { return signedIn() && (isAdmin() || request.resource.data[field] == myCompany()); }
    function ownsDoc(field)    { return signedIn() && (isAdmin() || resource.data[field] == myCompany()); }

    // ── Catálogo: leitura pública; escrita escopada por empresa ──────────────
    match /companies/{id} {
      allow read: if true;
      allow write: if isAdmin() || (signedIn() && id == myCompany());
    }
    match /loja_config/{id} {
      allow read: if true;
      allow create: if ownsCreate('empresaId');
      allow update, delete: if ownsDoc('empresaId');
    }
    match /categories/{id} {
      allow read: if true;
      allow create: if ownsCreate('companyId');
      allow update, delete: if ownsDoc('companyId');
    }
    match /instancias/{id} {
      allow read: if true;
      allow create: if ownsCreate('empresaId');
      allow update, delete: if ownsDoc('empresaId');
    }
    match /combos/{id} {
      allow read: if true;
      allow create: if ownsCreate('empresaId');
      allow update, delete: if ownsDoc('empresaId');
    }

    // ── Produtos: escrita só backend; leitura pública (catálogo) ──
    match /products/{id} { allow read: if true; }

    // ── Pedidos: escrita só backend; leitura escopada por empresa ──
    // (o catálogo NÃO lê pedidos; o painel filtra por empresaId)
    match /pedidos/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.empresaId == myCompany());
    }

    // ── Coleções do painel (leitura + escrita escopadas por empresa) ──────────
    match /messages/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.empresaId == myCompany());
    } // criado só pelo backend
    match /leads/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.empresaId == myCompany());
      allow create: if ownsCreate('empresaId');
      allow update, delete: if ownsDoc('empresaId');
    }
    match /campanhas/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.cliente_id == myCompany());
      allow create: if ownsCreate('cliente_id');
      allow update, delete: if ownsDoc('cliente_id');
    }
    match /agendamentos/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.companyId == myCompany());
      allow create: if ownsCreate('companyId');
      allow update, delete: if ownsDoc('companyId');
    }
    match /clientes/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.companyId == myCompany());
      allow create: if ownsCreate('companyId');
      allow update, delete: if ownsDoc('companyId');
    }

    // ── Usuários (ler o próprio doc, os da mesma empresa, ou admin) ──
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && (uid == request.auth.uid || resource.data.companyId == myCompany()));
      allow create: if isAdmin() || (signedIn() && request.resource.data.companyId == myCompany());
      allow update, delete: if isAdmin() || (signedIn() && (uid == request.auth.uid || resource.data.companyId == myCompany()));
    }

    // ── Settings globais (billing OpenAI): só admin ──────────────────────────
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Sem catch-all: qualquer coleção não listada acima fica bloqueada.
  }
}
