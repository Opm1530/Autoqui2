# Porta do servidor
PORT=3005

# Origens permitidas (CORS) — separadas por vírgula
ALLOWED_ORIGINS=https://autoqui.com.br

# Evolution API (a chave sai do frontend e vem pra cá)
EVOLUTION_API_URL=https://evolution.vps.pequi.digital
EVOLUTION_API_KEY=coloque_a_chave_aqui

# Caminho do JSON da service account do Firebase (montado no container)
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json
